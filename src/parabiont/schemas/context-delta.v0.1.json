{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/amiencoy/parabiont-protocol/main/src/parabiont/schemas/context-delta.v0.1.json",
  "title": "Parabiont Context Delta Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "created_at", "source_runtime", "status", "summary", "items"],
  "properties": {
    "version": {"const": "parabiont-delta/v0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_runtime": {"type": "string", "minLength": 1, "maxLength": 120},
    "status": {"const": "untrusted-proposal"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "topic", "labels", "text", "provenance", "confidence", "supersedes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9-]{1,64}$"},
          "kind": {"enum": ["fact", "decision", "task", "constraint"]},
          "topic": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
          "labels": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"}},
          "text": {"type": "string", "minLength": 1, "maxLength": 3000},
          "provenance": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 500}},
          "confidence": {"enum": ["verified", "operator-stated", "inferred", "unknown"]},
          "supersedes": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9-]{1,64}$"}}
        }
      }
    }
  }
}
